# Production secrets for deploy/docker-compose.yml. Copy to deploy/.env
# (ignored by git), fill in every value, and keep it only on the server:
#   cp deploy/.env.example deploy/.env && chmod 600 deploy/.env
# Random values: openssl rand -base64 32   (or: openssl rand -hex 32)

# The external MySQL (8.0.13 or later), from your provider's connection
# details. The user needs full rights on DB_NAME only; the API creates the
# tables itself on its first start. The password must not contain "/" (it
# goes inside the connection string) or "$" (compose would expand it): if
# your provider's does, set a new one, e.g. openssl rand -hex 24.
DB_HOST=
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASSWORD=
# TLS to the database: true (verified against public CAs), skip-verify
# (encrypted, but the provider's certificate isn't checked; for providers
# with their own CA), or false (only on a private network).
DB_TLS=true

# Signs the login sessions. Changing it logs everyone out.
SESSION_SECRET=

# The same OAuth client the web image is built with (the GOOGLE_CLIENT_ID
# repository variable of the images workflow).
# Its authorized JavaScript origins must include https://<your yorgut domain>.
GOOGLE_CLIENT_ID=

# How to reach you, the administrator: the help pages show it so people can
# report content that breaks the rules. Optional, but without it they can't.
ADMIN_EMAIL=

# The picture bucket's key pair (any values; only the API uses them).
# Letters and digits only: openssl rand -hex 16 / openssl rand -hex 32
S3_ACCESS_KEY=
S3_SECRET_KEY=

# From Cloudflare Zero Trust > Networks > Tunnels > your tunnel > install
# connector (the long value after --token).
TUNNEL_TOKEN=

# Optional: run a specific build instead of the newest one, e.g. to roll back.
# A commit sha from main (the images workflow tags each one). Empty = latest.
YORGUT_TAG=
