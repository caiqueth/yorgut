# Local development settings. Copy to backend/.env (ignored by git):
#   cp .env.example .env
# `make run`, `make seed` and the root docker-compose.yml "app" profile read it.
# Production doesn't: it uses deploy/.env (README.md, "Deploying").

# Database: SQLite in a file (DEV_MODE=true), or MySQL (DEV_MODE=false), e.g.
# the local one from `make db_up`:
#   DEV_MODE=false
#   DATABASE_DSN=localdev:localdev@tcp(localhost:3306)/yorgut-dev
DEV_MODE=true
DATABASE_DSN=local.db
PORT=8080

# Required: the API won't start without them.
# SESSION_SECRET signs the login sessions (openssl rand -hex 32).
# GOOGLE_CLIENT_ID is your Google OAuth client, the same as in frontend/.env.local.
SESSION_SECRET=
GOOGLE_CLIENT_ID=

# Pictures (README.md, "Uploads"): a folder served by the API, or an S3 bucket
# (STORAGE=s3 and the S3_* variables).
STORAGE=disk
UPLOADS_DIR=/absolute/path/to/yorgut/backend/storage/uploads
MEDIA_BASE_URL=http://localhost:8080/media

# Optional.
# Delays every /api response, to see loading states: 1s, or a range 300ms-2s.
API_DELAY=
# How to reach this instance's administrator, shown on the help pages.
ADMIN_EMAIL=
# The seed's main user: sign in with this Google account to get the most data.
SEED_MAIN_USER_EMAIL=
